+   /**
+    * Get the question types registered by other plugins through the
+    * "formcreator_get_question_types" hook (added by the dynamicfields plugin).
+    *
+    * @return array field_type => ['classname' => string, 'file' => string]
+    */
+   public static function getExternalTypes() {
+      static $types = null;
+      if ($types === null) {
+         $types = [];
+         foreach (Plugin::doHookFunction('formcreator_get_question_types', []) as $type => $data) {
+            if (!is_string($type) || $type === '') {
+               continue;
+            }
+            if (is_string($data) && class_exists($data)) {
+               $types[$type] = ['classname' => $data];
+            } else if (is_array($data) && isset($data['classname']) && class_exists($data['classname'])) {
+               $types[$type] = $data;
+            }
+         }
+      }
+      return $types;
+   }
