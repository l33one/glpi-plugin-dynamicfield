msgid "Campos Dinâmicos Formulário"
msgstr "Campos Dinâmicos Formulário"

msgid "Dynamic field"
msgstr "Campo dinâmico"

msgid "Dynamic field attribute"
msgid_plural "Dynamic field attributes"
msgstr[0] "Atributo do campo dinâmico"
msgstr[1] "Atributos do campo dinâmico"

msgid "Dynamic field source question"
msgid_plural "Dynamic field source questions"
msgstr[0] "Questão de origem do campo dinâmico"
msgstr[1] "Questões de origem do campo dinâmico"

msgid "Source question"
msgstr "Questão de origem"

msgid "Attribute"
msgstr "Atributo"

msgid "Attribute to display"
msgstr "Atributo a exibir"

msgid "Select a question of type \"GLPI object\" or \"Dropdown\" first."
msgstr "Selecione primeiro uma questão de origem do tipo \"Objeto do GLPI\" ou \"Lista suspensa\"."

msgid "No previous compatible question found."
msgstr "Nenhuma questão anterior compatível encontrada."

msgid "The attribute \"%s\" is not valid for the selected source question."
msgstr "O atributo \"%s\" não é válido para a questão de origem selecionada."

msgid "The plugin directory must be named \"dynamicfields\", so install the plugin under plugins/dynamicfields."
msgstr "O diretório do plugin deve ser nomeado \"dynamicfields\". Instale o plugin em plugins/dynamicfields."

msgid "The Formcreator plugin must be installed and active (version 2.13 or above)."
msgstr "O plugin Formcreator deve estar instalado e ativo (versão 2.13 ou superior)."

msgid "Formcreator is not patched to accept external question types. Apply the patch with: php plugins/dynamicfields/patches/apply.php"
msgstr "O Formcreator não está com o patch que aceita tipos de questão externos. Aplique o patch com: php plugins/dynamicfields/patches/apply.php"

msgid "The question type \"Campo Dinâmico\" is not registered."
msgstr "O tipo de questão \"Campo Dinâmico\" não está registrado."

msgid "UUID or ID is mandatory for %1$s"
msgstr "UUID ou ID é obrigatório para %1$s"

msgid "Failed to add or update the %1$s"
msgstr "Falha ao adicionar ou atualizar o %1$s"